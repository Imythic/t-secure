  "narrative": {
    "northStar": "A calm community-service guide",
    "overview": "T-Secure uses familiar web controls, generous reading space, and a reassuring voice. Its pale rose surfaces and magenta actions retain the T-Mobile association without turning a protection task into an alarm-heavy dashboard.\n\nThe system is primarily flat. Clear headings, readable guidance, and grounded evidence lead; decorative interface geometry stays secondary. Simulation labels and analysis-source explanations are part of the visible interface.",
    "keyCharacteristics": [
      "Clear task hierarchy and familiar controls.",
      "Large essential reading text at every breakpoint.",
      "White and rose surfaces with a purposeful magenta accent.",
      "Written risk labels, evidence, and verification actions together.",
      "Explicit distinctions between demonstrations and connected analysis."
    ],
    "rules": [
      {
        "name": "The Written Warning Rule",
        "body": "State colors accompany explicit labels, explanations, and evidence; they never carry risk meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Reading Size Rule",
        "body": "Essential protective guidance remains 20px at every breakpoint; shorten or reflow content before reducing its reading size.",
        "section": "typography"
      },
      {
        "name": "The Room to Read Rule",
        "body": "Preserve reading space by stacking panels and wrapping action rows; do not compress the essential copy.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do keep essential protective guidance at 20px across breakpoints.",
      "Do keep primary controls at least 48px in their active target area.",
      "Do pair warnings with written reasons, source labels, and verification actions.",
      "Do retain visible sample-data and concept labels beside demo results.",
      "Do use the shared inline SVG icon vocabulary and visible focus treatment."
    ],
    "donts": [
      "Don't use color alone to communicate risk.",
      "Don't make a sample score look like a verified prediction about the real user.",
      "Don't replace an insufficient-information state with zero.",
      "Don't reduce essential reading text to fit a narrow layout.",
      "Don't promote decorative preview geometry into the primary task."
    ]
  }
}
